# =============================================================================
# .env.example — coworking-back (NestJS + Prisma + PostgreSQL)
# Copiá este archivo como .env y completá los valores reales.
#   cp .env.example .env
# =============================================================================

# ── Base de datos ─────────────────────────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/coworking_db?schema=public"

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto en que escucha el servidor NestJS (default: 3550)
PORT=3550

# ── CORS ──────────────────────────────────────────────────────────────────────
# URLs del frontend separadas por coma (sin espacios)
# Desarrollo local:
CORS_ORIGIN="http://localhost:3551"
# Producción (ejemplo):
# CORS_ORIGIN="https://tudominio.com,https://www.tudominio.com"

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Producción: NODE_ENV=production

# =============================================================================
# SECRETS de GitHub Actions (no van en .env, van en Settings > Secrets)
# Referencia para saber qué configurar en el repo:
#
#   DATABASE_URL      → igual al de arriba pero apuntando a la DB de producción
#   CORS_ORIGIN       → URL del frontend en producción
#   PORT              → 3550 (o el que uses en el Droplet)
#   DO_HOST           → IP pública del Droplet de DigitalOcean
#   DO_USER           → usuario SSH del Droplet (ej: root)
#   DO_SSH_PRIVATE_KEY→ clave privada SSH (contenido completo del archivo id_rsa)
#   DO_PORT           → puerto SSH del Droplet (default: 22)
# =============================================================================
