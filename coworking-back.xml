266:   async autoLiberarVencidas() {
267:     const ahora      = new Date();
268:     const ahoraUTC3  = new Date(ahora.getTime() - 3 * 60 * 60 * 1000); // UTC-3
269:     const fechaHoy   = ahoraUTC3.toISOString().split('T')[0];
270:     const minutosNow = ahoraUTC3.getHours() * 60 + ahoraUTC3.getMinutes();
271: 
272:     try {
273:       // Buscar ocupaciones activas cuya fechaHasta ya pasó o es hoy y horaHasta ya pasó
274:       const candidatas = await this.prisma.ocupacion.findMany({
275:         where: {
276:           liberadaAt: null,
277:           fechaHasta: { lte: new Date(`${fechaHoy}T23:59:59.000Z`) },
278:         },
279:         include: { areas: { include: { area: true } } },
280:       });
281: 
282:       for (const oc of candidatas) {
283:         const fechaFin = oc.fechaHasta.toISOString().split('T')[0];
284: 
285:         // Si la fecha de fin ya pasó completamente
286:         if (fechaFin < fechaHoy) {
287:           await this.liberarInterno(oc);
288:           continue;
289:         }
290: 
291:         // Si es hoy, verificar que la hora ya pasó
292:         if (fechaFin === fechaHoy) {
293:           const minutosFin = timeToMinutes(oc.horaHasta);
294:           if (minutosNow >= minutosFin) {
295:             await this.liberarInterno(oc);
296:           }
297:         }
298:       }
299:     } catch (err) {
300:       this.logger.error('Error en autoLiberarVencidas:', (err as Error).message);
301:     }
302:   }
303: 
304:   private async liberarInterno(oc: { id: number; areas: { areaId: number }[] }) {
305:     const areaIds = oc.areas.map((r) => r.areaId);
306:     await this.prisma.$transaction(async (tx) => {
307:       if (areaIds.length > 0) {
308:         await tx.area.updateMany({ where: { id: { in: areaIds } }, data: { estado: AreaStatus.LIBRE } });
309:       }
310:       await tx.ocupacion.update({ where: { id: oc.id }, data: { liberadaAt: new Date() } });
311:     });
312:     this.logger.log(`⏰ Auto-liberada ocupación ${oc.id}`);
313:   }
