## File: prisma/prisma.service.ts
````typescript
 1: import { Injectable, OnModuleInit, OnModuleDestroy, Logger } from '@nestjs/common';
 2: import { PrismaClient } from '@prisma/client';
 3: import { PrismaPg } from '@prisma/adapter-pg';
 4: import * as pg from 'pg';
 5: 
 6: @Injectable()
 7: export class PrismaService extends PrismaClient implements OnModuleInit, OnModuleDestroy {
 8:   private readonly logger = new Logger(PrismaService.name);
 9:   private readonly pool: pg.Pool;
10: 
11:   constructor() {
12:     const connectionString = process.env.DATABASE_URL;
13: 
14:     // Pool con límite explícito — evita saturar PostgreSQL
15:     const pool = new pg.Pool({
16:       connectionString,
17:       max:                    10,   // máximo 10 conexiones simultáneas
18:       idleTimeoutMillis:   30_000, // libera conexiones inactivas a los 30s
19:       connectionTimeoutMillis: 5_000, // error si no consigue conexión en 5s
20:     });
21: 
22:     pool.on('error', (err) => {
23:       // Log del error pero sin crashear la app
24:       console.error('[PrismaService] Pool error:', err.message);
25:     });
26: 
27:     const adapter = new PrismaPg(pool);
28: 
29:     super({ adapter });
30: 
31:     // Guardar referencia para destruir el pool al apagar
32:     this.pool = pool;
33:   }
34: 
35:   async onModuleInit() {
36:     await this.$connect();
37:     this.logger.log('Prisma conectado (pool max=10)');
38:   }
39: 
40:   async onModuleDestroy() {
41:     await this.$disconnect();
42:     await this.pool.end();
43:     this.logger.log('Prisma desconectado');
44:   }
45: }
````

