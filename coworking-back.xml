102:           fechaHasta: fechaHastaDate,
103:           horaDesde,
104:           horaHasta,
105:           areas: {
106:             create: areaIds.map((areaId) => ({ areaId })),
107:           },
108:         },
109:         include: { areas: { include: { area: true } } },
110:       });
111: 
112:       // Marcar áreas como OCUPADO
113:       await tx.area.updateMany({
114:         where: { id: { in: areaIds } },
