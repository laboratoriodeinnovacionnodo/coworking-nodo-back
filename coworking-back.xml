112:   findOne(id: number) {
113:     return this.prisma.reserva.findUnique({
114:       where: { id },
115:       include: { usuario: true, area: true },
116:     });
117:   }
118: 
119:   // ── UPDATE ────────────────────────────────────────────────────────────────
120:   // Permite editar: nombre, detalles, recepcion (seguros, sin side-effects).
121:   // Si cambia areaId: libera el área vieja, valida y ocupa la nueva.
122:   async update(id: number, dto: UpdateReservaDto) {
123:     const reserva = await this.prisma.reserva.findUnique({
124:       where: { id },
125:       include: { area: true },
126:     });
127: 
128:     if (!reserva) throw new NotFoundException('Reserva no encontrada');
129:     if (reserva.fin !== null)
130:       throw new BadRequestException('No se puede editar una reserva ya completada');
131: 
132:     const { areaId, ...camposSeguros } = dto;
133: 
134:     // ── Sin cambio de área: actualización simple ──────────────────────────
135:     if (!areaId || areaId === reserva.areaId) {
136:       return this.prisma.reserva.update({
137:         where: { id },
138:         data: camposSeguros,
139:         include: { usuario: true, area: true },
140:       });
141:     }
142: 
143:     // ── Cambio de área: validar nueva área y reasignar ────────────────────
144:     const nuevaArea = await this.prisma.area.findUnique({ where: { id: areaId } });
145: 
146:     if (!nuevaArea) throw new NotFoundException('Área nueva no encontrada');
147:     if (nuevaArea.estado !== AreaStatus.LIBRE)
148:       throw new BadRequestException('El área nueva no está disponible');
149: 
150:     await this.verificarOcupacionActiva(areaId);
151: 
152:     return this.prisma.$transaction(async (tx) => {
153:       // 1. Actualizar reserva con nueva área + campos
154:       const actualizada = await tx.reserva.update({
155:         where: { id },
156:         data: { ...camposSeguros, areaId },
157:         include: { usuario: true, area: true },
158:       });
159: 
160:       // 2. Liberar área anterior (si no tiene otras reservas activas)
161:       const otrasReservasEnAreaVieja = await tx.reserva.count({
162:         where: {
163:           areaId: reserva.areaId,
164:           fin: null,
165:           id: { not: id },
166:         },
167:       });
168: 
169:       if (otrasReservasEnAreaVieja === 0) {
170:         await tx.area.update({
171:           where: { id: reserva.areaId },
172:           data: { estado: AreaStatus.LIBRE },
173:         });
174:       }
175: 
176:       // 3. Marcar nueva área como OCUPADO
177:       await tx.area.update({
178:         where: { id: areaId },
179:         data: { estado: AreaStatus.OCUPADO },
180:       });
181: 
182:       return actualizada;
183:     });
184:   }
185: 
186:   // ── COMPLETAR ─────────────────────────────────────────────────────────────
187:   async completarReserva(id: number) {
188:     const reserva = await this.prisma.reserva.findUnique({ where: { id } });
189:     if (!reserva) throw new NotFoundException('Reserva no encontrada');
190: 
191:     const finalizada = await this.prisma.reserva.update({
192:       where: { id },
193:       data: { fin: new Date() },
194:     });
195: 
196:     await this.prisma.area.update({
197:       where: { id: reserva.areaId },
198:       data: { estado: AreaStatus.LIBRE },
199:     });
200: 
201:     return finalizada;
202:   }
203: 
204:   // ── REMOVE ────────────────────────────────────────────────────────────────
205:   remove(id: number) {
206:     return this.prisma.reserva.delete({ where: { id } });
207:   }
208: }
