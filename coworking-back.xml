  1: import {
  2:   BadRequestException,
  3:   Injectable,
  4:   NotFoundException,
  5:   UnauthorizedException,
  6: } from '@nestjs/common';
  7: import { CreateAdminDto } from './dto/create-admin.dto';
  8: import { PrismaService } from 'prisma/prisma.service';
  9: import { UpdateAdminDto } from './dto/update-admin.dto';
 10: 
 11: @Injectable()
 12: export class AuthService {
 13:   constructor(private prisma: PrismaService) {}
 14: 
 15:   // 🔐 LOGIN
 16:   async login(email: string, password: string) {
 17:     const admin = await this.prisma.admin.findUnique({
 18:       where: { email },
 19:     });
 20: 
 21:     if (!admin || admin.password !== password) {
 22:       throw new UnauthorizedException('Credenciales inválidas');
 23:     }
 24: 
 25:     return {
 26:       id: admin.id,
 27:       email: admin.email,
 28:     };
 29:   }
 30: 
 31:   // ➕ CREATE ADMIN
 32:   async createAdmin(dto: CreateAdminDto) {
 33:     const exists = await this.prisma.admin.findUnique({
 34:       where: { email: dto.email },
 35:     });
 36: 
 37:     if (exists) {
 38:       throw new BadRequestException('El email ya está registrado');
 39:     }
 40: 
 41:     return this.prisma.admin.create({
 42:       data: dto,
 43:       select: {
 44:         id: true,
 45:         email: true,
 46:         createdAt: true,
 47:       },
 48:     });
 49:   }
 50: 
 51:   // 📄 FIND ALL ADMINS
 52:   async findAllAdmins() {
 53:     return this.prisma.admin.findMany({
 54:       select: {
 55:         id: true,
 56:         email: true,
 57:         createdAt: true,
 58:       },
 59:     });
 60:   }
 61: 
 62:   // 🔍 FIND ADMIN BY ID
 63:   async findAdminById(id: number) {
 64:     const admin = await this.prisma.admin.findUnique({
 65:       where: { id },
 66:       select: {
 67:         id: true,
 68:         email: true,
 69:         createdAt: true,
 70:       },
 71:     });
 72: 
 73:     if (!admin) {
 74:       throw new NotFoundException('Admin no encontrado');
 75:     }
 76: 
 77:     return admin;
 78:   }
 79: 
 80:   // ✏️ UPDATE ADMIN
 81:   async updateAdmin(id: number, dto: UpdateAdminDto) {
 82:     await this.findAdminById(id);
 83: 
 84:     return this.prisma.admin.update({
 85:       where: { id },
 86:       data: dto,
 87:       select: {
 88:         id: true,
 89:         email: true,
 90:         createdAt: true,
 91:       },
 92:     });
 93:   }
 94: 
 95:   // 🗑 DELETE ADMIN
 96:   async deleteAdmin(id: number) {
 97:     await this.findAdminById(id);
 98: 
 99:     return this.prisma.admin.delete({
100:       where: { id },
101:       select: {
102:         id: true,
103:         email: true,
104:       },
105:     });
106:   }
107: }
