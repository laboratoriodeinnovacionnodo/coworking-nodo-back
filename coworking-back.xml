 43:     const { areaIds, fechaDesde, fechaHasta, horaDesde, horaHasta, telefono, ...rest } = dto;
 44: 
 45:     const fechaDesdeDate = new Date(`${fechaDesde}T00:00:00.000Z`);
 46:     const fechaHastaDate = new Date(`${fechaHasta}T00:00:00.000Z`);
 47: 
 48:     if (fechaDesdeDate > fechaHastaDate) {
 49:       throw new BadRequestException('fechaDesde no puede ser posterior a fechaHasta');
 50:     }
 51:     if (timeToMinutes(horaDesde) >= timeToMinutes(horaHasta)) {
 52:       throw new BadRequestException('horaDesde debe ser anterior a horaHasta');
 53:     }
 54: 
 55:     // Verificar que todas las áreas existen
 56:     const areas = await this.prisma.area.findMany({ where: { id: { in: areaIds } } });
 57:     if (areas.length !== areaIds.length) {
 58:       const encontrados = areas.map((a) => a.id);
 59:       const faltantes   = areaIds.filter((id) => !encontrados.includes(id));
 60:       throw new NotFoundException(`Área(s) no encontrada(s): ${faltantes.join(', ')}`);
 61:     }
 62: 
 63:     // Verificar conflictos de horario con ocupaciones activas
 64:     const existentes = await this.prisma.ocupacion.findMany({
 65:       where: {
 66:         liberadaAt: null,
 67:         areas: { some: { areaId: { in: areaIds } } },
 68:       },
 69:       include: { areas: true },
 70:     });
 71: 
 72:     const conflictivas = existentes.filter((oc) =>
 73:       rangosSolapan(
 74:         fechaDesdeDate, fechaHastaDate, horaDesde, horaHasta,
 75:         oc.fechaDesde,  oc.fechaHasta,  oc.horaDesde, oc.horaHasta,
 76:       ),
