123:   findAll() {
124:     return this.prisma.ocupacion.findMany({
125:       orderBy: { createdAt: 'desc' },
126:       include: { areas: { include: { area: true } } },
127:     });
128:   }
129: 
130:   // ── FIND ACTIVAS ───────────────────────────────────────────────────────────
131:   findActivas() {
132:     const hoy = new Date();
133:     hoy.setUTCHours(0, 0, 0, 0);
134:     return this.prisma.ocupacion.findMany({
135:       where: {
136:         liberadaAt: null,
137:         fechaHasta: { gte: hoy },
138:       },
139:       orderBy: { fechaDesde: 'asc' },
140:       include: { areas: { include: { area: true } } },
141:     });
142:   }
143: 
144:   // ── FIND ONE ───────────────────────────────────────────────────────────────
145:   async findOne(id: number) {
146:     const oc = await this.prisma.ocupacion.findUnique({
147:       where: { id },
148:       include: { areas: { include: { area: true } } },
149:     });
150:     if (!oc) throw new NotFoundException('Ocupación no encontrada');
151:     return oc;
152:   }
153: 
154:   // ── UPDATE ─────────────────────────────────────────────────────────────────
155:   async update(id: number, dto: UpdateOcupacionDto) {
156:     await this.findOne(id);
157: 
158:     const { areaIds, fechaDesde, fechaHasta, horaDesde, horaHasta, telefono, ...rest } = dto;
159: 
160:     const fechaDesdeDate = fechaDesde ? new Date(`${fechaDesde}T00:00:00.000Z`) : undefined;
161:     const fechaHastaDate = fechaHasta ? new Date(`${fechaHasta}T00:00:00.000Z`) : undefined;
162: 
163:     return this.prisma.ocupacion.update({
164:       where: { id },
165:       data: {
166:         ...rest,
167:         ...(telefono !== undefined && { telefono }),
168:         ...(fechaDesdeDate && { fechaDesde: fechaDesdeDate }),
169:         ...(fechaHastaDate && { fechaHasta: fechaHastaDate }),
170:         ...(horaDesde && { horaDesde }),
171:         ...(horaHasta && { horaHasta }),
172:         ...(areaIds && {
173:           areas: {
174:             deleteMany: {},
175:             create: areaIds.map((areaId) => ({ areaId })),
176:           },
177:         }),
178:       },
179:       include: { areas: { include: { area: true } } },
180:     });
181:   }
182: 
183:   // ── LIBERAR ────────────────────────────────────────────────────────────────
184:   async liberar(id: number) {
185:     const oc = await this.findOne(id);
186: 
187:     return this.prisma.$transaction(async (tx) => {
188:       const liberada = await tx.ocupacion.update({
189:         where: { id },
190:         data:  { liberadaAt: new Date() },
191:         include: { areas: { include: { area: true } } },
192:       });
193: 
194:       const areaIds = oc.areas.map((r) => r.areaId);
195:       await tx.area.updateMany({
196:         where: { id: { in: areaIds } },
197:         data:  { estado: AreaStatus.LIBRE },
198:       });
199: 
200:       return liberada;
201:     });
202:   }
203: 
204:   // ── REMOVE ─────────────────────────────────────────────────────────────────
205:   async remove(id: number) {
206:     const oc = await this.findOne(id);
207: 
208:     return this.prisma.$transaction(async (tx) => {
209:       await tx.ocupacionArea.deleteMany({ where: { ocupacionId: id } });
210: 
211:       const removed = await tx.ocupacion.delete({ where: { id } });
212: 
213:       const areaIds = oc.areas.map((r) => r.areaId);
214:       await tx.area.updateMany({
215:         where: { id: { in: areaIds } },
216:         data:  { estado: AreaStatus.LIBRE },
217:       });
218: 
219:       return removed;
220:     });
221:   }
222: }
