 14:   return h * 60 + m;
 15: }
 16: 
 17: function rangosSolapan(
 18:   aDesde: Date, aHasta: Date, aHoraDesde: string, aHoraHasta: string,
 19:   bDesde: Date, bHasta: Date, bHoraDesde: string, bHoraHasta: string,
 20: ): boolean {
 21:   const aD = aDesde.toISOString().split('T')[0];
 22:   const aH = aHasta.toISOString().split('T')[0];
 23:   const bD = bDesde.toISOString().split('T')[0];
 24:   const bH = bHasta.toISOString().split('T')[0];
 25: 
 26:   if (aD > bH || aH < bD) return false;
 27: 
 28:   const aDesdeMin = timeToMinutes(aHoraDesde);
 29:   const aHastaMin = timeToMinutes(aHoraHasta);
 30:   const bDesdeMin = timeToMinutes(bHoraDesde);
 31:   const bHastaMin = timeToMinutes(bHoraHasta);
 32: 
 33:   return aDesdeMin < bHastaMin && aHastaMin > bDesdeMin;
 34: }
