````typescript
 1: import { Injectable, BadRequestException, NotFoundException } from '@nestjs/common';
 2: import { CreateReservaDto } from './dto/create-reserva.dto';
 3: import { UpdateReservaDto } from './dto/update-reserva.dto';
 4: import { PrismaService } from 'prisma/prisma.service';
 5: import { AreaStatus } from '@prisma/client';
 6: 
 7: @Injectable()
 8: export class ReservaService {
 9:   constructor(private prisma: PrismaService) {}
10: 
11:   async create(data: CreateReservaDto) {
12:     const area = await this.prisma.area.findUnique({
13:       where: { id: data.areaId },
14:     });
15: 
16:     if (!area) throw new NotFoundException('Área no encontrada');
17:     if (area.estado !== AreaStatus.LIBRE)
18:       throw new BadRequestException('El área no está disponible');
19: 
20:     // Crear la reserva
21:     const reserva = await this.prisma.reserva.create({ data });
22: 
23:     // Cambiar estado del área a OCUPADO
24:     await this.prisma.area.update({
25:       where: { id: data.areaId },
26:       data: { estado: AreaStatus.OCUPADO },
27:     });
28: 
29:     return reserva;
30:   }
31: 
32:   findAll() {
33:     return this.prisma.reserva.findMany({
34:       include: { usuario: true, area: true },
35:     });
36:   }
37: 
38:   findOne(id: number) {
39:     return this.prisma.reserva.findUnique({
40:       where: { id },
41:       include: { usuario: true, area: true },
42:     });
43:   }
44: 
45:   update(id: number, data: UpdateReservaDto) {
46:     return this.prisma.reserva.update({
47:       where: { id },
48:       data,
49:     });
50:   }
51: 
52:   async completarReserva(id: number) {
53:     const reserva = await this.prisma.reserva.findUnique({ where: { id } });
54:     if (!reserva) throw new NotFoundException('Reserva no encontrada');
55: 
56:     // Finalizar reserva
57:     const finalizada = await this.prisma.reserva.update({
58:       where: { id },
59:       data: { fin: new Date() },
60:     });
61: 
62:     // Restaurar área a "LIBRE"
63:     await this.prisma.area.update({
64:       where: { id: reserva.areaId },
65:       data: { estado: AreaStatus.LIBRE },
66:     });
