11:   create(data: CreateAreaDto) {
12:     return this.prisma.area.create({ data });
13:   }
14: 
15:   findAll() {
16:     return this.prisma.area.findMany();
17:   }
18: 
19:   findOne(id: number) {
20:     return this.prisma.area.findUnique({ where: { id } });
21:   }
22: 
23:   update(id: number, data: UpdateAreaDto) {
24:     return this.prisma.area.update({
25:       where: { id },
26:       data
27:     });
28:   }
29: 
30:   async remove(id: number) {
31:     await this.prisma.reserva.deleteMany({
32:       where: { areaId: id },
33:     });
34: 
35:     return this.prisma.area.delete({
36:       where: { id },
37:     });
38:   }
